<?xml version="1.0" encoding="utf-8"?>
<com.opscope.app.SlideFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slideRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B10">

    <LinearLayout
        android:id="@+id/mainPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:background="#0D1420">

            <TextView
                android:id="@+id/menuBtnMain"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:text="☰"
                android:textColor="#4A90FF"
                android:textSize="20sp"
                android:background="#122038" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingStart="12dp"
                android:text="OPSCOPE — REAL SIGNAL INSTRUMENT"
                android:textColor="#7A93B8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== HORIZONTAL SPLIT: graph left, controls right ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- LEFT PANE: graph + zoom + capture -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp">

                <com.opscope.app.ScopeView
                    android:id="@+id/scopeView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pinch to zoom · drag to pan · real ADC samples only"
                    android:textColor="#7A93B8"
                    android:textSize="9.5sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button android:id="@+id/zoomOutBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Zoom −" android:textSize="11sp" />
                    <Button android:id="@+id/resetZoomBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Reset" android:textSize="11sp" />
                    <Button android:id="@+id/zoomInBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Zoom +" android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rVoltage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voltage: -- (no real capture yet)"
                    android:textColor="#4A90FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/rRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rate: --"
                    android:textColor="#7A93B8"
                    android:textSize="10sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button android:id="@+id/liveCaptureBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Start Live Capture" android:textSize="11sp" />
                    <Button android:id="@+id/reconBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Clear Capture" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#1A2740" />

            <!-- RIGHT PANE: connect + dial + commands + stats + chat + log -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#0D1420"
                        android:padding="10dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/connStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Not connected"
                            android:textColor="#FF5A5A"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/connectBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Connect"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FREQUENCY CONTROL"
                        android:textColor="#7A93B8"
                        android:textSize="10sp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/rTargetBig"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1000.00 Hz"
                        android:textColor="#4A90FF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <com.opscope.app.DialView
                        android:id="@+id/dialView"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <Button android:id="@+id/coarseModeBtn" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="REAL" android:textSize="11sp" />
                        <Button android:id="@+id/fineModeBtn" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="PRECISE" android:textSize="11sp" />
                        <Button android:id="@+id/precisionBtn" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="FAST" android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <Button android:id="@+id/downFreqBtn" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="◀ Hold" android:textSize="11sp" />
                        <Button android:id="@+id/speed1xBtn" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="1×" android:textSize="11sp" />
                        <Button android:id="@+id/speed2xBtn" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="2×" android:textSize="11sp" />
                        <Button android:id="@+id/upFreqBtn" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="Hold ▶" android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <Button android:id="@+id/minus1Btn" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="−1" android:textSize="11sp" />
                        <Button android:id="@+id/minus01Btn" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="−0.1" android:textSize="10sp" />
                        <Button android:id="@+id/plus01Btn" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="+0.1" android:textSize="10sp" />
                        <Button android:id="@+id/plus1Btn" android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" android:text="+1" android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESP32 COMMANDS"
                        android:textColor="#7A93B8"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:layout_marginBottom="6dp">

                        <Button android:id="@+id/btnCmdH" android:layout_width="0dp" android:layout_columnWeight="1"
                            android:layout_height="wrap_content" android:layout_margin="3dp"
                            android:text="H\nHELP" android:textSize="11sp" android:lines="2" />
                        <Button android:id="@+id/btnCmdM" android:layout_width="0dp" android:layout_columnWeight="1"
                            android:layout_height="wrap_content" android:layout_margin="3dp"
                            android:text="M\nMANUAL" android:textSize="11sp" android:lines="2" />
                        <Button android:id="@+id/btnCmdD" android:layout_width="0dp" android:layout_columnWeight="1"
                            android:layout_height="wrap_content" android:layout_margin="3dp"
                            android:text="D\nDUTY" android:textSize="11sp" android:lines="2" />
                    </GridLayout>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:layout_marginBottom="10dp">

                        <Button android:id="@+id/btnCmdC" android:layout_width="0dp" android:layout_columnWeight="1"
                            android:layout_height="wrap_content" android:layout_margin="3dp"
                            android:text="C\nCAPTURE" android:textSize="11sp" android:lines="2" />
                        <Button android:id="@+id/btnCmdS" android:layout_width="0dp" android:layout_columnWeight="1"
                            android:layout_height="wrap_content" android:layout_margin="3dp"
                            android:text="S\nDIAGNOSTICS" android:textSize="11sp" android:lines="2" />
                        <View android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" />
                    </GridLayout>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:layout_marginBottom="10dp">

                        <TextView android:id="@+id/rTarget" android:layout_width="0dp" android:layout_columnWeight="1"
                            android:layout_height="wrap_content" android:text="Target: --" android:textColor="#4A90FF" android:padding="6dp" android:textSize="11sp" />
                        <TextView android:id="@+id/rMeasured" android:layout_width="0dp" android:layout_columnWeight="1"
                            android:layout_height="wrap_content" android:text="Measured: --" android:textColor="#4A90FF" android:padding="6dp" android:textSize="11sp" />
                        <TextView android:id="@+id/rDuty" android:layout_width="0dp" android:layout_columnWeight="1"
                            android:layout_height="wrap_content" android:text="Duty: --" android:textColor="#4A90FF" android:padding="6dp" android:textSize="11sp" />
                    </GridLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="OPSCOPE AI"
                        android:textColor="#6AA8FF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <ScrollView
                        android:id="@+id/chatScroll"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="#0D1420"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/chatView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:textColor="#BFD4EE"
                            android:fontFamily="monospace"
                            android:textSize="10sp" />
                    </ScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <EditText
                            android:id="@+id/chatInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Ask about measured Hz, capture, or ESP32"
                            android:textColor="#BFD4EE"
                            android:textColorHint="#7A93B8"
                            android:inputType="text"
                            android:singleLine="true"
                            android:imeOptions="actionSend"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/chatSendBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ask"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="LOG"
                            android:textColor="#7A93B8"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/clearLogBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clear Log"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/logScroll"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="#050A10">

                        <TextView
                            android:id="@+id/logView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:textColor="#4A90FF"
                            android:fontFamily="monospace"
                            android:textSize="10sp" />
                    </ScrollView>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= LOGBOOK (screen 2) ================= -->
    <LinearLayout
        android:id="@+id/logbookPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#070B10"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:background="#0D1420">

            <TextView
                android:id="@+id/menuBtnLog"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:text="☰"
                android:textColor="#4A90FF"
                android:textSize="20sp"
                android:background="#122038" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingStart="12dp"
                android:text="OPSCOPE — LOGBOOK"
                android:textColor="#7A93B8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Swipe from the left edge (or tap ☰) to open the menu.\nEvery app action + every line from the ESP32, timestamped.\nOne .txt file per connection — tap a saved file below to open it."
                android:textColor="#7A93B8"
                android:textSize="9.5sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/liveBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="● LIVE"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/refreshFilesBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Refresh files"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/viewerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Live session"
                android:textColor="#FFB347"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#0D1420">

                <ScrollView
                    android:id="@+id/logbookScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <TextView
                        android:id="@+id/logbookView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:textColor="#4A90FF"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:textIsSelectable="true" />
                </ScrollView>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingStart="12dp"
            android:paddingRight="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVED SESSIONS"
                android:textColor="#7A93B8"
                android:textSize="10.5sp"
                android:layout_marginBottom="4dp" />

            <ScrollView
                android:id="@+id/sessionsScroll"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="#0D1420">

                <LinearLayout
                    android:id="@+id/sessionsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/scrimView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawerView"
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0D1420"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NAVIGATE"
            android:textColor="#7A93B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/drawerMainOpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="#122038"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAIN APP"
                android:textColor="#4A90FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="scope + frequency controls"
                android:textColor="#7A93B8"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerLogOpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="#00000000"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOGBOOK"
                android:textColor="#BFD4EE"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="timestamped session files"
                android:textColor="#7A93B8"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</com.opscope.app.SlideFrameLayout>
